# Host nginx/Caddy-alternative snippet for 13.140.219.161 only.
# Proxies https://postiz.evotechly.com -> 127.0.0.1:4007 (loopback).
# TLS paths are placeholders; reuse the same ACME/cert arrangement as plane.evotechly.com.
# Do not listen on a public port for Postiz except 443 on this vhost.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name postiz.evotechly.com;

    # ssl_certificate     /path/to/postiz.evotechly.com/fullchain.pem;
    # ssl_certificate_key /path/to/postiz.evotechly.com/privkey.pem;

    client_max_body_size 2G;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://127.0.0.1:4007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
