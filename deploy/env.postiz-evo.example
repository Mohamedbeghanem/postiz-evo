# Copy to deploy/postiz.env on 13.140.219.161 and fill REPLACE_ME values.
# Never commit postiz.env. Never put guessed OAuth / Stripe / OpenAI keys here.
# Leave social-provider keys unset until the owner creates real apps.

# Tag the image with the tree you are building (required by compose).
# POSTIZ_GIT_SHA=$(git rev-parse HEAD)
POSTIZ_GIT_SHA=REPLACE_ME_WITH_git_rev_parse_HEAD

# --- Public URL (must match DNS / TLS on the host reverse proxy) ---
# Do not point public DNS at this stack until first-owner bootstrap is done
# and BOOTSTRAP_REGISTRATION is false again. Loopback 4007 is the only listener.
POSTIZ_PUBLIC_URL=https://postiz.evotechly.com
POSTIZ_LOOPBACK_PORT=4007

# --- Secrets (generate on the host; do not reuse Plane or EvoCRM secrets) ---
JWT_SECRET=REPLACE_ME_WITH_LONG_RANDOM_STRING
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=REPLACE_ME_DB_PASSWORD
POSTIZ_DB_NAME=postiz
TEMPORAL_DB_PASSWORD=REPLACE_ME_TEMPORAL_DB_PASSWORD

# --- Required application flags ---
IS_GENERAL=true
DISABLE_REGISTRATION=true
# false = nobody can register, including the first SUPERADMIN. Flip to true only
# on loopback (or behind temporary proxy auth), register the owner, then set
# false again and recreate the container.
BOOTSTRAP_REGISTRATION=false
# Host-only cookies. Do not set Domain=.evotechly.com — that would send the
# Postiz `auth` JWT to plane.evotechly.com and every other sibling.
COOKIE_HOST_ONLY=true
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/uploads
NOT_SECURED=

# --- Do not set EMAIL_PROVIDER for first-owner onboarding ---
# Unset EMAIL_PROVIDER => first local register is activated immediately.
# Setting resend/ses/nodemailer requires a working inbox before anyone can log in.

# --- Optional. Leave empty. Do not invent values. ---
# OPENAI_API_KEY=
# EMAIL_PROVIDER=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# X_API_KEY=
# X_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
